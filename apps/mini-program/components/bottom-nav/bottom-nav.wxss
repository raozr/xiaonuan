.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #ffffff;
  border-top: 1rpx solid #f0ebe6;
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  flex: 1;
  height: 100%;
}

.nav-icon {
  font-size: 40rpx;
  line-height: 1.2;
}

.nav-label {
  font-size: 22rpx;
  color: #877365;
}

.nav-item.active .nav-label {
  color: #8f4e00;
  font-weight: 600;
}
