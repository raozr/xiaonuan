.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #f6e5da;
  border-radius: 24px 24px 0 0;
  box-shadow: 0 -4px 20px rgba(143, 78, 0, 0.1);
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 8px 16px 24px;
  z-index: 50;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8px 24px;
  border-radius: 24px;
  opacity: 0.7;
  transition: all 0.2s ease;
}

.nav-item.active {
  background-color: #ff9f43;
  opacity: 1;
}

.nav-icon {
  font-size: 20px;
  margin-bottom: 2px;
}

.nav-label {
  font-size: 12px;
  font-weight: 700;
  color: #506873;
}

.nav-item.active .nav-label {
  color: #ffffff;
}
