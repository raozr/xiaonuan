.container {
  padding: 24px;
  background-color: #fff8f5;
  min-height: 100vh;
}

.card {
  background: #ffffff;
  border-radius: 24px;
  padding: 20px;
  margin-bottom: 16px;
  box-shadow: 0 4px 16px rgba(143, 78, 0, 0.08);
}

.card-title {
  display: block;
  font-size: 18px;
  font-weight: 700;
  color: #8f4e00;
  margin-bottom: 16px;
}

.form-row {
  display: flex;
  align-items: center;
  margin-bottom: 12px;
}

.form-row-column {
  flex-direction: column;
  align-items: flex-start;
}

.form-label {
  width: 90px;
  font-size: 15px;
  color: #544437;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  height: 40px;
  background: #faf5f0;
  border-radius: 12px;
  padding: 0 12px;
  font-size: 15px;
  color: #221a13;
}

.form-picker {
  flex: 1;
  height: 40px;
  background: #faf5f0;
  border-radius: 12px;
  padding: 0 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-text {
  font-size: 15px;
  color: #221a13;
}

.picker-arrow {
  font-size: 14px;
  color: #877365;
}

.form-textarea {
  width: 100%;
  height: 80px;
  background: #faf5f0;
  border-radius: 12px;
  padding: 10px 12px;
  font-size: 15px;
  color: #221a13;
  margin-top: 6px;
  box-sizing: border-box;
}

.invite-row {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12px;
}

.invite-code-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.invite-code {
  font-size: 36px;
  font-weight: 800;
  color: #8f4e00;
  letter-spacing: 4px;
}

.invite-actions {
  display: flex;
  gap: 16px;
}

.invite-action {
  font-size: 14px;
  color: #8f4e00;
  font-weight: 600;
}

.invite-hint {
  display: block;
  font-size: 12px;
  color: #877365;
}

.refresh {
  color: #8f4e00;
}

.member-list {
  width: 100%;
  margin-top: 6px;
}

.member-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 12px;
  background: #faf5f0;
  border-radius: 12px;
  margin-bottom: 6px;
}

.member-name {
  font-size: 15px;
  color: #221a13;
}

.member-rel {
  font-size: 13px;
  color: #877365;
}

.about-card {
  text-align: center;
  padding: 16px;
}

.about-text {
  font-size: 14px;
  color: #877365;
}

.btn-save {
  height: 48px;
  background: #8f4e00;
  color: #ffffff;
  border-radius: 24px;
  font-size: 16px;
  font-weight: 700;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-back {
  height: 48px;
  background: transparent;
  color: #877365;
  font-size: 16px;
}
