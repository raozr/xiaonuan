<view class="container">
  <!-- 子女信息卡片 -->
  <view class="card">
    <text class="card-title">子女信息</text>
    <view class="form-row">
      <text class="form-label">姓名</text>
      <input class="form-input" placeholder="您的姓名" value="{{childName}}" bindinput="onChildNameInput" />
    </view>
    <view class="form-row">
      <text class="form-label">与老人关系</text>
      <picker mode="selector" range="{{relationships}}" value="{{relationships.indexOf(childRelationship)}}" bindchange="onChildRelationshipChange">
        <view class="form-picker">
          <text class="picker-text">{{childRelationship || '请选择'}}</text>
          <text class="picker-arrow">></text>
        </view>
      </picker>
    </view>
    <view class="form-row form-row-column">
      <text class="form-label">其他信息</text>
      <textarea class="form-textarea" placeholder="如我在北京工作、我是大学老师、每两周回家一次等，供 AI 在陪伴中引用" value="{{childCustomNotes}}" bindinput="onChildCustomNotesInput" maxlength="500" />
    </view>
  </view>

  <!-- 老人信息卡片 -->
  <view class="card">
    <text class="card-title">老人信息</text>
    <view class="form-row">
      <text class="form-label">姓名 *</text>
      <input class="form-input" placeholder="老人姓名" value="{{elderName}}" bindinput="onElderNameInput" />
    </view>
    <view class="form-row">
      <text class="form-label">年龄</text>
      <picker mode="selector" range="{{ageRange}}" value="{{ageRange.indexOf(elderAge)}}" bindchange="onElderAgeChange">
        <view class="form-picker">
          <text class="picker-text">{{elderAge ? elderAge + ' 岁' : '请选择'}}</text>
          <text class="picker-arrow">></text>
        </view>
      </picker>
    </view>
    <view class="form-row">
      <text class="form-label">方言</text>
      <picker mode="selector" range="{{dialects}}" value="{{dialects.indexOf(elderDialect)}}" bindchange="onElderDialectChange">
        <view class="form-picker">
          <text class="picker-text">{{elderDialect || '请选择'}}</text>
          <text class="picker-arrow">></text>
        </view>
      </picker>
    </view>
    <view class="form-row form-row-column">
      <text class="form-label">爱好</text>
      <textarea class="form-textarea" placeholder="如养花、听京剧、下棋等" value="{{elderHobbies}}" bindinput="onElderHobbiesInput" maxlength="200" />
    </view>
    <view class="form-row form-row-column">
      <text class="form-label">健康注意事项</text>
      <textarea class="form-textarea" placeholder="如腰不好、避免剧烈运动等" value="{{elderHealthNotes}}" bindinput="onElderHealthNotesInput" maxlength="200" />
    </view>
    <view class="form-row form-row-column">
      <text class="form-label">回避话题</text>
      <textarea class="form-textarea" placeholder="如已故的老伴等敏感话题" value="{{elderTopicsToAvoid}}" bindinput="onElderTopicsToAvoidInput" maxlength="200" />
    </view>
    <view class="form-row">
      <text class="form-label">问候偏好</text>
      <input class="form-input" placeholder="称呼我老王就行" value="{{elderGreetingPreference}}" bindinput="onElderGreetingPreferenceInput" />
    </view>
  </view>

  <!-- 老人端绑定码 -->
  <view class="card">
    <text class="card-title">老人端绑定码</text>
    <view class="invite-code-row">
      <text class="invite-code">{{inviteCode}}</text>
      <view class="invite-actions">
        <text class="invite-action" bindtap="copyInviteCode">复制</text>
        <text class="invite-action refresh" bindtap="refreshInviteCode">重新生成</text>
      </view>
    </view>
    <text class="invite-hint">让老人在 APP 中输入此 6 位数字即可绑定</text>
  </view>

  <!-- 关于 -->
  <view class="card about-card">
    <text class="about-text">小暖 v0.1.0</text>
  </view>

  <button class="btn-save" bindtap="save" loading="{{loading}}">保存</button>
  <button class="btn-back" bindtap="goBack">返回</button>
</view>
