<view class="container">
  <view class="header">
    <text class="title">我的老人</text>
    <view class="add-btn" bindtap="goToAddElder">
      <text class="add-icon">+</text>
      <text>添加老人</text>
    </view>
  </view>

  <scroll-view scroll-y="{{true}}" class="elder-list">
    <view wx:if="{{families.length === 0}}" class="empty-state">
      <view class="empty-icon">👴</view>
      <text class="empty-text">您还没有关联任何老人</text>
      <view class="btn-primary" bindtap="goToAddElder">添加第一位老人</view>
    </view>

    <block wx:else>
      <view class="family-card" wx:for="{{families}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
        <view class="card-left">
          <view class="avatar">
            <text>{{item.elder.name[0]}}</text>
          </view>
        </view>
        <view class="card-content">
          <text class="elder-name">{{item.elder.name}}</text>
          <text class="last-active">最后活跃：{{item.lastActive || '今日未通话'}}</text>
          <view class="status-tag {{item.isOnline ? 'online' : ''}}">
            {{item.isOnline ? '陪伴中' : '休息中'}}
          </view>
        </view>
        <view class="card-right">
          <text class="arrow">›</text>
        </view>
      </view>
    </block>

    <view class="footer-spacer"></view>
  </scroll-view>

  <view class="footer-actions">
    <text class="logout-link" bindtap="handleLogout">退出登录</text>
  </view>

</view>
