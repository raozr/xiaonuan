.container {
  padding: 48px 24px;
  background-color: #fff8f5;
  min-height: 100vh;
}

.logo {
  text-align: center;
  margin-bottom: 48px;
}

.logo-text {
  display: block;
  font-size: 48px;
  font-weight: 800;
  color: #8f4e00;
}

.logo-sub {
  display: block;
  font-size: 18px;
  color: #544437;
  margin-top: 8px;
}

.title {
  display: block;
  font-size: 24px;
  font-weight: 700;
  color: #221a13;
  margin-bottom: 24px;
  text-align: center;
}

.role-select {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.role-card {
  background: #ffffff;
  border-radius: 24px;
  padding: 32px;
  text-align: center;
  box-shadow: 0 4px 16px rgba(143, 78, 0, 0.1);
}

.role-icon {
  display: block;
  font-size: 48px;
  margin-bottom: 12px;
}

.role-title {
  display: block;
  font-size: 24px;
  font-weight: 700;
  color: #221a13;
}

.role-desc {
  display: block;
  font-size: 16px;
  color: #544437;
  margin-top: 4px;
}

.login-form {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.input {
  height: 56px;
  background: #ffffff;
  border-radius: 16px;
  padding: 0 16px;
  font-size: 18px;
  border: 1px solid #dac2b1;
}

.code-row {
  display: flex;
  gap: 12px;
}

.code-input {
  flex: 1;
}

.btn-code {
  width: 140px;
  height: 56px;
  background: #ff9f43;
  color: #ffffff;
  border-radius: 16px;
  font-size: 16px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-code[disabled] {
  background: #e7d7cc;
  color: #877365;
}

.btn-login {
  height: 56px;
  background: #ff9f43;
  color: #ffffff;
  border-radius: 16px;
  font-size: 20px;
  font-weight: 700;
  margin-top: 8px;
}

.btn-back {
  height: 48px;
  background: transparent;
  color: #877365;
  font-size: 16px;
}
