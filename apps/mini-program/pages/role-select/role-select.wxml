<view class="container">
  <view class="logo">
    <text class="logo-text">小暖</text>
    <text class="logo-sub">AI 陪伴，温暖每一天</text>
  </view>

  <view class="role-select">
    <text class="title">请选择您的身份</text>
    <view class="role-card" data-role="ELDER" bindtap="selectRole">
      <text class="role-icon">👴</text>
      <text class="role-title">我是老人</text>
      <text class="role-desc">开始使用小暖陪伴</text>
    </view>
    <view class="role-card" data-role="CHILD" bindtap="selectRole">
      <text class="role-icon">👨‍👩‍👧</text>
      <text class="role-title">我是子女</text>
      <text class="role-desc">为父母设置小暖</text>
    </view>
  </view>
</view>
