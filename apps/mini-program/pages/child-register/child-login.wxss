.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  min-height: 100vh;
  background: #f8f9fa;
}

.header {
  text-align: center;
  margin-bottom: 80rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.subtitle {
  font-size: 28rpx;
  color: #888;
  margin-top: 16rpx;
  display: block;
}

.auth-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.logo-text {
  font-size: 96rpx;
  font-weight: 800;
  color: #8f4e00;
  margin-bottom: 60rpx;
  display: block;
}

.hint {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 40rpx;
}

.auth-btn {
  width: 80%;
  height: 96rpx;
  line-height: 96rpx;
  background: #07c160;
  color: #fff;
  font-size: 32rpx;
  border-radius: 48rpx;
  border: none;
}

.auth-btn::after {
  border: none;
}

.tip {
  font-size: 24rpx;
  color: #aaa;
  margin-top: 24rpx;
}

.phone-input {
  width: 80%;
  height: 96rpx;
  padding: 0 32rpx;
  margin-bottom: 40rpx;
  background: #ffffff;
  border: 1px solid #ddd;
  border-radius: 48rpx;
  font-size: 32rpx;
  color: #333;
  text-align: center;
  box-sizing: border-box;
}
