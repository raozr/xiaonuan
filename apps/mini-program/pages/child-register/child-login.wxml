<view class="container">
  <view class="header">
    <text class="title">欢迎加入小暖</text>
    <text class="subtitle">授权手机号，一键登录</text>
  </view>

  <view class="auth-section">
    <text class="logo-text">小暖</text>

    <block wx:if="{{!showPhoneLogin}}">
      <text class="hint">点击下方按钮授权微信手机号</text>
      <button
        class="auth-btn"
        open-type="getPhoneNumber"
        bind:getphonenumber="onGetPhoneNumber"
        loading="{{loading}}"
      >
        授权手机号登录
      </button>
      <text class="tip">小暖将保护您的隐私安全</text>
    </block>

    <block wx:if="{{showPhoneLogin}}">
      <text class="hint">请输入手机号登录</text>
      <input
        class="phone-input"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        value="{{phoneInput}}"
        bindinput="onPhoneInput"
      />
      <button
        class="auth-btn"
        bindtap="phoneLogin"
        loading="{{loading}}"
      >
        登录
      </button>
      <text class="tip" style="color:#888">未注册手机号将自动创建家庭</text>
    </block>
  </view>
</view>
