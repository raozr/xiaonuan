.container {
  padding: 24px;
  background-color: #fff8f5;
  min-height: 100vh;
}

/* Header */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.back-btn {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  color: #8f4e00;
  background-color: #faf5f0;
  border-radius: 20px;
}

.header-title {
  font-size: 20px;
  font-weight: 700;
  color: #8f4e00;
  flex: 1;
  text-align: center;
}

.header-placeholder {
  width: 40px;
}

/* Input Card */
.input-card {
  background-color: #ffffff;
  border-radius: 24px;
  padding: 20px;
  margin-bottom: 24px;
  box-shadow: 0 4px 16px rgba(143, 78, 0, 0.08);
}

/* Mode Switch */
.mode-switch {
  display: flex;
  gap: 8px;
  margin-bottom: 16px;
}

.mode-btn {
  flex: 1;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20px;
  font-size: 15px;
  font-weight: 600;
  color: #544437;
  background-color: #fff1e8;
  transition: all 0.2s ease;
}

.mode-btn.active {
  background-color: #8f4e00;
  color: #ffffff;
}

/* Text Input */
.text-input-area {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.text-area {
  width: 100%;
  height: 120px;
  background-color: #faf5f0;
  border-radius: 16px;
  padding: 14px;
  font-size: 16px;
  color: #221a13;
  box-sizing: border-box;
  border: 2px solid transparent;
}

.text-area:focus {
  border-color: #ff9f43;
  background-color: #ffffff;
}

.send-btn {
  height: 48px;
  background-color: #8f4e00;
  color: #ffffff;
  border-radius: 24px;
  font-size: 16px;
  font-weight: 700;
  box-shadow: 0 4px 12px rgba(143, 78, 0, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-btn[disabled] {
  background-color: #e7d7cc;
  color: #877365;
  box-shadow: none;
}

/* Voice Input */
.voice-input-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  padding: 20px 0;
}

.voice-hint {
  font-size: 16px;
  font-weight: 600;
  color: #8f4e00;
}

.voice-btn {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  background-color: #8f4e00;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 24px rgba(143, 78, 0, 0.25);
  transition: all 0.2s ease;
}

.voice-btn.recording {
  transform: scale(1.1);
  background-color: #ff6b6b;
  box-shadow: 0 8px 24px rgba(255, 107, 107, 0.3);
}

.voice-icon {
  font-size: 40px;
}

.voice-tip {
  font-size: 14px;
  color: #877365;
}

/* History Section */
.history-section {
  margin-bottom: 24px;
}

.history-title {
  display: block;
  font-size: 20px;
  font-weight: 700;
  color: #221a13;
  margin-bottom: 16px;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.feed-item {
  background-color: #ffffff;
  border-radius: 16px;
  padding: 16px;
  display: flex;
  gap: 12px;
  box-shadow: 0 2px 8px rgba(143, 78, 0, 0.05);
  border-left: 4px solid transparent;
}

.feed-item:nth-child(odd) {
  border-left-color: #ff9f43;
}

.feed-item:nth-child(even) {
  border-left-color: #006879;
}

.feed-badge {
  width: 40px;
  height: 24px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  flex-shrink: 0;
}

.text-badge {
  background-color: #ffdcc2;
  color: #6d3a00;
}

.voice-badge {
  background-color: #cde6f4;
  color: #506873;
}

.feed-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.feed-text {
  font-size: 16px;
  color: #221a13;
  line-height: 24px;
  word-break: break-all;
}

.feed-time {
  font-size: 12px;
  color: #877365;
}

.empty-state {
  text-align: center;
  padding: 40px 0;
}

.empty-text {
  font-size: 16px;
  color: #877365;
}
