.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48px 24px;
  background-color: #fff8f5;
  min-height: 100vh;
}

.greeting {
  text-align: center;
  margin-bottom: 48px;
}

.greeting-text {
  display: block;
  font-size: 28px;
  font-weight: 700;
  color: #8f4e00;
}

.greeting-sub {
  display: block;
  font-size: 18px;
  color: #544437;
  margin-top: 8px;
}

.avatar-wrap {
  position: relative;
  width: 200px;
  height: 200px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32px;
}

.avatar {
  width: 160px;
  height: 160px;
  background: #ffecd9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  transition: transform 0.3s ease;
}

.avatar-face {
  font-size: 80px;
}

.avatar.listening {
  transform: scale(1.1);
  background: #ffd8b8;
}

.avatar.speaking {
  animation: speakPulse 0.6s ease-in-out infinite alternate;
}

@keyframes speakPulse {
  from { transform: scale(1); }
  to { transform: scale(1.08); }
}

.breath-ring {
  position: absolute;
  width: 200px;
  height: 200px;
  border-radius: 50%;
  background: rgba(255, 159, 67, 0.15);
  z-index: 1;
  animation: breathe 3s ease-in-out infinite;
}

@keyframes breathe {
  0%, 100% { transform: scale(1); opacity: 0.6; }
  50% { transform: scale(1.15); opacity: 0.3; }
}

.hint {
  font-size: 18px;
  color: #877365;
  margin-bottom: 48px;
  height: 24px;
}

.voice-btn {
  width: 140px;
  height: 140px;
  border-radius: 50%;
  background: #ff9f43;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 24px rgba(143, 78, 0, 0.2);
  transition: transform 0.15s ease, background 0.15s ease;
}

.voice-btn:active,
.voice-btn.active {
  transform: scale(0.95);
  background: #e0852e;
}

.voice-icon {
  font-size: 56px;
  color: #ffffff;
}

.chat-area {
  width: 100%;
  max-width: 320px;
  margin-bottom: 24px;
}

.chat-bubble {
  padding: 12px 16px;
  border-radius: 16px;
  margin-bottom: 12px;
}

.chat-bubble.elder {
  background: #fff0e6;
  border-bottom-left-radius: 4px;
}

.chat-bubble.ai {
  background: #ffe4cc;
  border-bottom-right-radius: 4px;
}

.chat-label {
  display: block;
  font-size: 12px;
  color: #b38b6d;
  margin-bottom: 4px;
}

.chat-text {
  display: block;
  font-size: 16px;
  color: #5c3d2e;
  line-height: 1.5;
}

.btn-logout {
  margin-top: auto;
  height: 48px;
  background: transparent;
  color: #877365;
  font-size: 16px;
}
