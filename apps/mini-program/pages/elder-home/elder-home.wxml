<view class="container">
  <!-- AppBar -->
  <view class="app-bar">
    <view class="app-bar-avatar">
      <text class="app-bar-avatar-face">🐻</text>
    </view>
    <text class="app-bar-title">Xiao Nuan</text>
    <view class="app-bar-action" bindtap="goToHistory">
      <text class="icon-history">记录</text>
    </view>
  </view>

  <!-- Main Content -->
  <view class="main">
    <!-- Avatar Area -->
    <view class="avatar-wrap">
      <view class="pulse-ring-outer" wx:if="{{isListening}}"></view>
      <view class="pulse-ring-inner" wx:if="{{isListening}}"></view>
      <view class="ambient-glow" wx:if="{{isSpeaking}}"></view>

      <view class="avatar {{isSpeaking ? 'speaking' : ''}}">
        <text class="avatar-face">🐻</text>
      </view>

      <!-- Waveform -->
      <view class="waveform" wx:if="{{isListening || isSpeaking}}">
        <view class="wave-bar" style="height: {{waveHeights[0]}}rpx"></view>
        <view class="wave-bar" style="height: {{waveHeights[1]}}rpx"></view>
        <view class="wave-bar" style="height: {{waveHeights[2]}}rpx"></view>
        <view class="wave-bar" style="height: {{waveHeights[3]}}rpx"></view>
        <view class="wave-bar" style="height: {{waveHeights[4]}}rpx"></view>
      </view>
    </view>

    <!-- Hint -->
    <view class="hint-area">
      <text wx:if="{{isListening}}" class="hint-text listening-hint">我在听…</text>
      <text wx:elif="{{isProcessing}}" class="hint-text processing-hint">小暖在想…</text>
      <text wx:elif="{{isSpeaking}}" class="hint-text speaking-hint">小暖在说…</text>
      <text wx:else class="hint-text default-hint">按住下方按钮说话</text>
    </view>

    <!-- AI Transcript Bubble -->
    <view class="transcript-bubble" wx:if="{{isSpeaking && aiReplyText}}">
      <text class="transcript-text">{{aiReplyText}}</text>
    </view>
  </view>

  <!-- FAB -->
  <view class="fab-area">
    <!-- Mic Button (Default / Listening / Processing) -->
    <view
      wx:if="{{!isSpeaking}}"
      class="fab {{isListening ? 'active' : ''}} {{isProcessing ? 'processing' : ''}}"
      bindtouchstart="onTouchStart"
      bindtouchend="onTouchEnd"
    >
      <text class="fab-icon">{{isProcessing ? '⏳' : '🎙'}}</text>
    </view>

    <!-- Interrupt Button (Speaking) -->
    <view
      wx:if="{{isSpeaking}}"
      class="fab interrupt"
      bindtap="onInterrupt"
    >
      <text class="fab-icon">✋</text>
      <text class="fab-label">打断</text>
    </view>
  </view>
</view>
