.container {
  padding: 24px;
  background-color: #fff8f5;
  min-height: 100vh;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24px;
}

.header-left {
  flex: 1;
}

.settings-icon {
  font-size: 14px;
  color: #877365;
  padding: 6px 12px;
  background: #faf5f0;
  border-radius: 16px;
}

.guide-card {
  background: #fff3e0;
  border-radius: 16px;
  padding: 16px 20px;
  margin-bottom: 16px;
  border: 1px solid #ffcc80;
}

.guide-text {
  display: block;
  font-size: 16px;
  color: #8f4e00;
  margin-bottom: 12px;
}

.guide-actions {
  display: flex;
  gap: 12px;
}

.guide-btn {
  padding: 8px 20px;
  border-radius: 20px;
  font-size: 14px;
  color: #8f4e00;
  background: #ffffff;
}

.guide-btn-primary {
  background: #ff9f43;
  color: #ffffff;
}

.title {
  display: block;
  font-size: 24px;
  font-weight: 700;
  color: #8f4e00;
}

.subtitle {
  display: block;
  font-size: 16px;
  color: #544437;
  margin-top: 4px;
}

.status-card {
  background: #ffffff;
  border-radius: 24px;
  padding: 24px;
  margin-bottom: 16px;
  box-shadow: 0 4px 16px rgba(143, 78, 0, 0.08);
}

.date {
  display: block;
  font-size: 14px;
  color: #877365;
  margin-bottom: 8px;
}

.mood-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.mood {
  font-size: 32px;
  font-weight: 800;
  color: #ff9f43;
}

.duration {
  font-size: 14px;
  color: #544437;
}

.topics {
  display: block;
  font-size: 16px;
  color: #544437;
  margin-bottom: 16px;
}

.highlight-title {
  display: block;
  font-size: 14px;
  color: #877365;
  margin-bottom: 8px;
}

.highlight-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 4px;
}

.dot {
  color: #ff9f43;
  margin-right: 8px;
  font-weight: 700;
}

.highlight-text {
  font-size: 16px;
  color: #221a13;
  flex: 1;
}

.action-card {
  background: #ffffff;
  border-radius: 24px;
  padding: 20px;
  display: flex;
  align-items: center;
  box-shadow: 0 4px 16px rgba(143, 78, 0, 0.08);
  margin-bottom: 24px;
}

.action-icon {
  width: 48px;
  height: 48px;
  background: #ff9f43;
  color: #ffffff;
  border-radius: 50%;
  font-size: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16px;
}

.action-title {
  display: block;
  font-size: 18px;
  font-weight: 700;
  color: #221a13;
}

.action-desc {
  display: block;
  font-size: 14px;
  color: #877365;
  margin-top: 2px;
}

.btn-logout {
  height: 48px;
  background: transparent;
  color: #877365;
  font-size: 16px;
}
