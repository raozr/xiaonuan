.container {
  padding: 24px 24px 160rpx;
  background-color: #fff8f5;
  min-height: 100vh;
  box-sizing: border-box;
}

/* Header */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.header-avatar {
  width: 40px;
  height: 40px;
  border-radius: 20px;
  background-color: #ff9f43;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.header-avatar text {
  font-size: 18px;
  font-weight: 700;
  color: #ffffff;
}

.header-title {
  font-size: 24px;
  font-weight: 700;
  color: #8f4e00;
}

.header-settings {
  width: 40px;
  height: 40px;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #faf5f0;
}

/* Invite Code Card */
.invite-card {
  background-color: #ffffff;
  border-radius: 24px;
  padding: 20px;
  margin-bottom: 24px;
  box-shadow: 0 4px 16px rgba(143, 78, 0, 0.08);
}

.invite-label {
  display: block;
  font-size: 14px;
  color: #877365;
  margin-bottom: 12px;
}

.invite-code-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.invite-code {
  font-size: 32px;
  font-weight: 800;
  color: #ff6b6b;
  letter-spacing: 4px;
}

.invite-actions {
  display: flex;
  gap: 16px;
}

.invite-action {
  font-size: 14px;
  color: #ff9f43;
  font-weight: 600;
}

.invite-hint {
  display: block;
  font-size: 12px;
  color: #877365;
}

/* Summary Card */
.summary-card {
  background-color: #ffffff;
  border-radius: 24px;
  padding: 24px;
  margin-bottom: 24px;
  box-shadow: 0 8px 30px rgba(143, 78, 0, 0.1);
  border: 1px solid rgba(218, 194, 177, 0.3);
  position: relative;
  overflow: hidden;
}

.summary-card.empty {
  padding: 40px 24px;
  text-align: center;
}

.empty-text {
  font-size: 16px;
  color: #877365;
}

.summary-header {
  margin-bottom: 16px;
  position: relative;
  z-index: 1;
}

.summary-title {
  display: block;
  font-size: 24px;
  font-weight: 700;
  color: #221a13;
  margin-bottom: 4px;
}

.summary-date {
  display: block;
  font-size: 16px;
  color: #544437;
}

/* Bento Grid */
.bento-grid {
  display: flex;
  gap: 12px;
  position: relative;
  z-index: 1;
}

.bento-widget {
  flex: 1;
  background-color: #fff1e8;
  border-radius: 16px;
  padding: 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border: 1px solid rgba(218, 194, 177, 0.5);
  box-shadow: 0 2px 8px rgba(143, 78, 0, 0.05);
}

.widget-icon {
  width: 48px;
  height: 48px;
  border-radius: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  margin-bottom: 4px;
}

.mood-icon {
  background-color: #ff9f43;
}

.duration-icon {
  background-color: #cde6f4;
}

.widget-value {
  font-size: 16px;
  font-weight: 700;
  color: #221a13;
}

.widget-label {
  font-size: 14px;
  color: #544437;
}

/* Highlights Section */
.highlights-section {
  margin-bottom: 24px;
}

.section-title {
  display: block;
  font-size: 24px;
  font-weight: 700;
  color: #221a13;
  margin-bottom: 16px;
}

.highlights-card {
  background-color: #ffffff;
  border-radius: 20px;
  padding: 20px;
  box-shadow: 0 2px 12px rgba(143, 78, 0, 0.06);
  border: 1px solid rgba(218, 194, 177, 0.5);
}

.timeline {
  position: relative;
  padding-left: 8px;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 19px;
  top: 8px;
  bottom: 8px;
  width: 2px;
  background-color: rgba(218, 194, 177, 0.4);
}

.timeline-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 16px;
  position: relative;
}

.timeline-item:last-child {
  margin-bottom: 0;
}

.timeline-dot {
  width: 24px;
  height: 24px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  flex-shrink: 0;
  margin-top: 2px;
  border: 3px solid #ffffff;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
  z-index: 1;
}

.dot-0 {
  background-color: #8f4e00;
  color: #ffffff;
}

.dot-1 {
  background-color: #006879;
  color: #ffffff;
}

.dot-2 {
  background-color: #4a626d;
  color: #ffffff;
}

.timeline-content {
  flex: 1;
  background-color: #fff1e8;
  border-radius: 12px;
  padding: 12px 16px;
  box-shadow: 0 1px 4px rgba(143, 78, 0, 0.05);
  border: 1px solid rgba(218, 194, 177, 0.3);
}

.timeline-text {
  font-size: 16px;
  color: #221a13;
  line-height: 24px;
}

/* Tell Button */
.tell-btn {
  background-color: #8f4e00;
  border-radius: 24px;
  padding: 0 20px;
  height: 88px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 12px 24px rgba(143, 78, 0, 0.2);
  margin-bottom: 24px;
  transition: all 0.2s ease;
}

.tell-btn:active {
  transform: scale(0.98);
  background-color: #6d3a00;
}

.tell-btn-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.tell-icon {
  width: 48px;
  height: 48px;
  border-radius: 24px;
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  color: #ffffff;
}

.tell-text {
  font-size: 20px;
  font-weight: 700;
  color: #ffffff;
}

.tell-arrow {
  font-size: 24px;
  color: rgba(255, 255, 255, 0.8);
}
