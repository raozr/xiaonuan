<view class="container">
  <!-- Header -->
  <view class="header">
    <view class="header-left">
      <view class="header-avatar">
        <text>{{elderNameFirstChar}}</text>
      </view>
      <text class="header-title">{{(familyInfo && familyInfo.elder && familyInfo.elder.name) || '老人'}}的陪伴</text>
    </view>
    <view class="header-settings" bindtap="goToSettings">
      <text>⚙️</text>
    </view>
  </view>

  <!-- Today's Summary -->
  <view class="summary-card" wx:if="{{todaySummary}}">
    <view class="summary-header">
      <text class="summary-title">Today's Summary</text>
      <text class="summary-date">{{todayDate}}</text>
    </view>
    <view class="bento-grid">
      <view class="bento-widget">
        <view class="widget-icon mood-icon">☀️</view>
        <text class="widget-value">{{todaySummary.mood}}</text>
        <text class="widget-label">情绪</text>
      </view>
      <view class="bento-widget">
        <view class="widget-icon duration-icon">⏱️</view>
        <text class="widget-value">{{todaySummary.durationText}}</text>
        <text class="widget-label">时长</text>
      </view>
    </view>
  </view>

  <!-- Empty State -->
  <view class="summary-card empty" wx:if="{{!todaySummary}}">
    <text class="empty-text">今天还没有陪伴记录</text>
  </view>

  <!-- Today's Highlights -->
  <view class="highlights-section" wx:if="{{todaySummary && todaySummary.highlights && todaySummary.highlights.length > 0}}">
    <text class="section-title">Today's Highlights</text>
    <view class="highlights-card">
      <view class="timeline">
        <view class="timeline-item" wx:for="{{todaySummary.highlights}}" wx:key="index">
          <view class="timeline-dot dot-{{index % 3}}">
            <text>{{index === 0 ? '💬' : (index === 1 ? '🏔️' : '❤️')}}</text>
          </view>
          <view class="timeline-content">
            <text class="timeline-text">{{item}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- Tell Xiao Nuan Button -->
  <view class="tell-btn" bindtap="goToFeed">
    <view class="tell-btn-left">
      <view class="tell-icon">+</view>
      <text class="tell-text">告诉小暖一件事</text>
    </view>
    <text class="tell-arrow">→</text>
  </view>

  <!-- Invite Code Card -->
  <view class="invite-card" wx:if="{{inviteCode}}">
    <text class="invite-label">老人端绑定码</text>
    <view class="invite-code-row">
      <text class="invite-code">{{inviteCode}}</text>
      <view class="invite-actions">
        <text class="invite-action" bindtap="copyInviteCode">复制</text>
        <text class="invite-action refresh" bindtap="refreshInviteCode">重新生成</text>
      </view>
    </view>
    <text class="invite-hint">让老人在 APP 中输入此 6 位数字即可绑定</text>
  </view>

</view>

<bottom-nav active="overview" familyId="{{familyId}}" />
