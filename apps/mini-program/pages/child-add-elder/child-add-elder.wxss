.container {
  padding: 32rpx;
  background-color: #fff8f5;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  margin-bottom: 48rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #4a3b2a;
}

.form {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 48rpx;
  box-shadow: 0 4rpx 20rpx rgba(143, 78, 0, 0.06);
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.label {
  font-size: 28rpx;
  font-weight: 500;
  color: #4a3b2a;
}

.input {
  height: 96rpx;
  background: #faf5f0;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: #4a3b2a;
  box-sizing: border-box;
}

.input::placeholder {
  color: #c4b5a5;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  background: #ff9f43;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-primary[loading] {
  opacity: 0.8;
}
