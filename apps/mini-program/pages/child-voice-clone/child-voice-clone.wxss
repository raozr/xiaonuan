.container {
  padding: 32rpx 32rpx 160rpx;
  background-color: #fff8f5;
  min-height: 100vh;
  box-sizing: border-box;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #8f4e00;
  margin-bottom: 8rpx;
}

.page-subtitle {
  display: block;
  font-size: 28rpx;
  color: #877365;
  margin-bottom: 40rpx;
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #221a13;
  margin-bottom: 20rpx;
}

.sample-list {
  margin-bottom: 20rpx;
}

.sample-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(143, 78, 0, 0.05);
}

.sample-name {
  font-size: 28rpx;
  color: #544437;
}

.sample-remove {
  font-size: 26rpx;
  color: #ff6b6b;
}

.record-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 0;
}

.record-btn {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #8f4e00;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(143, 78, 0, 0.25);
}

.record-btn.recording {
  background: #ff6b6b;
  transform: scale(1.05);
}

.record-icon {
  font-size: 56rpx;
}

.record-hint {
  font-size: 26rpx;
  color: #877365;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  background: #8f4e00;
  color: #ffffff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.clone-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.clone-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(143, 78, 0, 0.05);
}

.clone-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.clone-status {
  font-size: 28rpx;
  font-weight: 600;
  color: #8f4e00;
}

.clone-status.READY {
  color: #2ecc71;
}

.clone-date {
  font-size: 22rpx;
  color: #877365;
}

.clone-actions {
  display: flex;
  gap: 20rpx;
}

.action-text {
  font-size: 26rpx;
  font-weight: 600;
}

.action-text.activate {
  color: #8f4e00;
}

.action-text.active {
  color: #2ecc71;
}

.action-text.delete {
  color: #ff6b6b;
}
