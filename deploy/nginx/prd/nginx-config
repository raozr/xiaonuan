# ==================================================
# AI Face Analysis Gateway Configuration
# ==================================================

# --------------------------------------------------
# HTTP Server (Port 80)
# --------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name localhost;

    client_max_body_size 50M;

    # Global Root for Static Files (Verification)
    root /usr/share/nginx/html;

    # 1. Health Check / Root Status
    location / {
        try_files $uri @status;
    }

    location @status {
        add_header Content-Type text/plain;
        return 200 "AI Face Analysis Gateway is Running (HTTP)";
    }

