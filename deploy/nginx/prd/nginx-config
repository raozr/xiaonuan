# --------------------------------------------------
# HTTPS Server (Port 443)
# --------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name localhost;

    client_max_body_size 50M;

    # SSL Certificates
    ssl_certificate /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    
    # SSL Optimization
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;

    # Global Root for Static Files
    root /usr/share/nginx/html;

    # 1. Domain Verification (.well-known)
    # Priority matching for SSL validation files
    location ^~ /.well-known/ {
        allow all;
        try_files $uri =404;
    }

    # 2. Health Check / Root Status
    location / {
        proxy_pass http://derper:12345; # 确保指向你的 derper 容器名和端口
    
        # 核心：必须强制指定 1.1 协议
        proxy_http_version 1.1;
    
        # 核心：透传 WebSocket 升级头部
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    
         # 核心：必须传递真实的 Host，否则 DERP 会因为校验域名不匹配而拒绝连接
        proxy_set_header Host $host;
    
        # 传递真实 IP（辅助打洞）
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 架构师调优：禁用所有缓存和缓冲，DERP 需要实时流
        proxy_buffering off;
        proxy_cache off;
    
        # 防止长连接超时
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    location @status {
        add_header Content-Type text/plain;
        return 200 "AI Face Analysis Gateway is Running (HTTPS)";
    }

