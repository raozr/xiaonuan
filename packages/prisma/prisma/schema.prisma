generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Core Models ──────────────────────────────────────────────────────────────

model Pairing {
  id            String   @id @default(cuid())
  name          String
  inviteCode    String   @unique @map("invite_code")
  inviteCodeExpiresAt DateTime? @map("invite_code_expires_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  participants  Participant[]
  sessions      Session[]
  feeds         FeedMessage[]
  dailySummaries DailySummary[]
  voiceClones   VoiceClone[]
  events        EventStream[]
  personas      PersonaProfile[]
  aiPersona     AIPersona?

  @@map("pairings")
}

model Participant {
  id          String        @id @default(cuid())
  pairingId   String        @map("pairing_id")
  userId      String?       @map("user_id")
  name        String
  role        ParticipantRole
  isAI        Boolean       @default(false) @map("is_ai")
  phone       String?
  openid      String?       @map("openid")
  deviceId    String?       @unique @map("device_id")
  metadata    Json?         // dialect, deviceId, hobbies, healthNotes, topicsToAvoid, greetingPreference, timezone
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  pairing     Pairing       @relation(fields: [pairingId], references: [id], onDelete: Cascade)
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  events      EventStream[]
  persona     PersonaProfile[]

  @@unique([userId, pairingId])
  @@map("participants")
}

enum ParticipantRole {
  COMPANIONEE
  STEWARD
}

model AIPersona {
  id            String   @id @default(cuid())
  pairingId     String   @unique @map("pairing_id")
  name          String   // e.g. "贴心小暖"
  template      String   @map("template") // e.g. "caring-companion"
  traits        Json        // e.g. {"warm": true, "humorous": true}
  tone          String?
  constraints   Json?       // e.g. {"maxDailyMessages": 10, "noMedicalAdvice": true}
  systemPrompt  String?  @map("system_prompt")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  pairing       Pairing  @relation(fields: [pairingId], references: [id], onDelete: Cascade)

  @@map("ai_personas")
}

model PersonaProfile {
  id            String   @id @default(cuid())
  pairingId     String   @map("pairing_id")
  participantId String   @map("participant_id")
  category      String   // e.g. "hobby", "health", "preference", "habit"
  content       String
  confidence    Float    @default(0.5)
  source        String?  // e.g. "feed", "checkpoint", "conversation"
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  pairing       Pairing   @relation(fields: [pairingId], references: [id], onDelete: Cascade)
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@map("persona_profiles")
}

model FeedMessage {
  id          String   @id @default(cuid())
  pairingId   String   @map("pairing_id")
  type        FeedType
  content     String
  audioUrl    String?  @map("audio_url")
  photoUrl    String?  @map("photo_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  pairing     Pairing  @relation(fields: [pairingId], references: [id], onDelete: Cascade)

  @@map("feed_messages")
}

model EventStream {
  id          String      @id @default(cuid())
  pairingId   String      @map("pairing_id")
  actorId     String?     @map("actor_id")
  type        EventType
  content     String      @map("content")
  tags        String[]
  payload     Json?
  eventTime   DateTime    @default(now()) @map("event_time")
  createdAt   DateTime    @default(now()) @map("created_at")

  pairing     Pairing     @relation(fields: [pairingId], references: [id], onDelete: Cascade)
  actor       Participant? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([pairingId, eventTime])
  @@index([actorId])
  @@map("event_stream")
}

enum EventType {
  feed_message
  conversation_turn
  conversation_extracted
  info_extracted
  mood_change
  relationship_shift
  proactive_outreach
  persona_updated
}

// ─── Preserved Models (with familyId → pairingId) ────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String?
  phone     String?  @unique
  openid    String?  @unique @map("openid")
  password  String?  @map("password")
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  participants Participant[]

  @@map("users")
}

enum UserRole {
  COMPANIONEE
  STEWARD
}

model Session {
  id        String   @id @default(cuid())
  pairingId String   @map("pairing_id")
  phase     SessionPhase @default(GREETING)
  startedAt DateTime @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  turnCount Int      @default(0) @map("turn_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pairing   Pairing  @relation(fields: [pairingId], references: [id], onDelete: Cascade)
  checkpoints Checkpoint[]
  messages  SessionMessage[]

  @@map("sessions")
}

model SessionMessage {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  role      String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_messages")
}

enum SessionPhase {
  GREETING
  ACTIVE_CHAT
  CLOSING
  ENDED
}

model Checkpoint {
  id            String   @id @default(cuid())
  sessionId     String   @map("session_id")
  topicSummary  String   @map("topic_summary")
  keyFacts      String[] @map("key_facts")
  moodSnapshot  String   @map("mood_snapshot")
  nextTopicHint String?  @map("next_topic_hint")
  checkpointId  String   @unique @map("checkpoint_id")
  createdAt     DateTime @default(now()) @map("created_at")

  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("checkpoints")
}

model DailySummary {
  id          String   @id @default(cuid())
  pairingId   String   @map("pairing_id")
  date        DateTime @db.Date
  moodLabel   String   @map("mood_label")
  duration    Int      @default(0)
  topicCount  Int      @default(0) @map("topic_count")
  highlights  String[]
  concerns    String?
  createdAt   DateTime @default(now()) @map("created_at")

  pairing     Pairing  @relation(fields: [pairingId], references: [id], onDelete: Cascade)

  @@unique([pairingId, date])
  @@map("daily_summaries")
}

enum Gender {
  MALE
  FEMALE
}

model VoiceClone {
  id          String   @id @default(cuid())
  pairingId   String   @map("pairing_id")
  createdBy   String   @map("created_by")
  voiceId     String   @map("voice_id")
  status      VoiceCloneStatus
  sampleUrls  String[] @map("sample_urls")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  pairing     Pairing  @relation(fields: [pairingId], references: [id], onDelete: Cascade)

  @@map("voice_clones")
}

enum VoiceCloneStatus {
  PENDING
  TRAINING
  READY
  FAILED
}

enum FeedType {
  TEXT
  VOICE
  PHOTO
}
