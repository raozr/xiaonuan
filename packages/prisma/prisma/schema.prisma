generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Family {
  id            String   @id @default(cuid())
  inviteCode    String   @unique @map("invite_code")
  inviteCodeExpiresAt DateTime? @map("invite_code_expires_at")
  clonedVoiceId String?  @map("cloned_voice_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  elder         ElderProfile?
  children      ChildProfile[]
  sessions      Session[]
  feeds         FamilyFeed[]
  dailySummaries DailySummary[]
  habitLogs     HabitLog[]
  voiceClones   VoiceClone[]

  @@map("families")
}

model ElderProfile {
  id                String   @id @default(cuid())
  familyId          String   @unique @map("family_id")
  name              String
  gender            Gender?
  age               Int?
  dialect           String?
  deviceId          String?  @unique @map("device_id")
  openid            String?  @map("openid")
  hobbies           String?  @map("hobbies")
  healthNotes       String?  @map("health_notes")
  topicsToAvoid     String?  @map("topics_to_avoid")
  greetingPreference String? @map("greeting_preference")
  timezone          String?  @default("Asia/Shanghai") @map("timezone")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  family            Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@map("elder_profiles")
}

model ChildProfile {
  id                  String   @id @default(cuid())
  familyId            String   @map("family_id")
  userId              String   @map("user_id")
  name                String?
  phone               String
  openid              String?  @map("openid")
  isPrimary           Boolean  @default(false) @map("is_primary")
  relationshipToElder String?  @map("relationship_to_elder")
  customNotes         String?  @map("custom_notes")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  family              Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId])
  @@map("child_profiles")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  phone     String?  @unique
  openid    String?  @unique @map("openid")
  password  String?  @map("password")
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  childProfiles ChildProfile[]

  @@map("users")
}

enum UserRole {
  ELDER
  CHILD
}

model Session {
  id        String   @id @default(cuid())
  familyId  String   @map("family_id")
  phase     SessionPhase @default(GREETING)
  startedAt DateTime @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  turnCount Int      @default(0) @map("turn_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  checkpoints Checkpoint[]
  messages  SessionMessage[]

  @@map("sessions")
}

model SessionMessage {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  role      String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_messages")
}

enum SessionPhase {
  GREETING
  ACTIVE_CHAT
  CLOSING
  ENDED
}

model Checkpoint {
  id            String   @id @default(cuid())
  sessionId     String   @map("session_id")
  topicSummary  String   @map("topic_summary")
  keyFacts      String[] @map("key_facts")
  moodSnapshot  String   @map("mood_snapshot")
  nextTopicHint String?  @map("next_topic_hint")
  checkpointId  String   @unique @map("checkpoint_id")
  createdAt     DateTime @default(now()) @map("created_at")

  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("checkpoints")
}

model FamilyFeed {
  id          String   @id @default(cuid())
  familyId    String   @map("family_id")
  type        FeedType
  content     String
  category    FeedCategory
  isRecent    Boolean  @default(false) @map("is_recent")
  audioUrl    String?  @map("audio_url")
  photoUrl    String?  @map("photo_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@map("family_feeds")
}

enum FeedType {
  TEXT
  VOICE
  PHOTO
}

enum FeedCategory {
  PERSON
  PLACE
  EVENT
  PREFERENCE
  HEALTH
}

model DailySummary {
  id          String   @id @default(cuid())
  familyId    String   @map("family_id")
  date        DateTime @db.Date
  moodLabel   String   @map("mood_label")
  duration    Int      @default(0)
  topicCount  Int      @default(0) @map("topic_count")
  highlights  String[]
  concerns    String?
  createdAt   DateTime @default(now()) @map("created_at")

  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, date])
  @@map("daily_summaries")
}

model HabitLog {
  id          String   @id @default(cuid())
  familyId    String   @map("family_id")
  openedAt    DateTime @map("opened_at")
  closedAt    DateTime? @map("closed_at")
  duration    Int      @default(0)
  topicCount  Int      @default(0) @map("topic_count")
  createdAt   DateTime @default(now()) @map("created_at")

  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@map("habit_logs")
}

enum Gender {
  MALE
  FEMALE
}

model VoiceClone {
  id          String   @id @default(cuid())
  familyId    String   @map("family_id")
  createdBy   String   @map("created_by")
  voiceId     String   @map("voice_id")
  status      VoiceCloneStatus
  sampleUrls  String[] @map("sample_urls")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@map("voice_clones")
}

enum VoiceCloneStatus {
  PENDING
  TRAINING
  READY
  FAILED
}
